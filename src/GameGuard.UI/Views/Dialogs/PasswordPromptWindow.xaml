<Window x:Class="GameGuard.UI.Views.Dialogs.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrator Authentication"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}">

    <Border Padding="24" Background="{StaticResource BrushSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Administrator Authentication" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Text="Please enter your admin PIN/password to authorize this change." Style="{StaticResource SubtextStyle}" Margin="0,0,0,16" TextWrapping="Wrap" />

            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Style="{StaticResource DarkPasswordBoxStyle}" Height="38" />

            <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource BrushDanger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource OutlineButtonStyle}" Width="90" Margin="0,0,12,0" />
                <Button Content="Authenticate" Click="OnAuthenticateClick" Style="{StaticResource PrimaryButtonStyle}" Width="120" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
