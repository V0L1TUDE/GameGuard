<Window x:Class="GameGuard.UI.Views.Dialogs.AddOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grant Administrator Override"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}">

    <Border Padding="28" Background="{StaticResource BrushSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Grant Administrator Override" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Grant temporary playtime extension, unlock games, or enforce immediate lockdown." Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <!-- Target Game -->
                <TextBlock Text="Target Game" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <ComboBox x:Name="GameSelector" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,16" />

                <!-- Override Type -->
                <TextBlock Text="Override Type" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <ComboBox x:Name="TypeSelector" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,16" SelectionChanged="OnTypeChanged" />

                <!-- Minutes / Duration -->
                <TextBlock x:Name="DurationLabel" Text="Additional Playtime (Minutes)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <TextBox x:Name="MinutesInput" Text="30" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,16" />

                <!-- Reason -->
                <TextBlock Text="Reason / Audit Note" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <TextBox x:Name="ReasonInput" Text="Parent approved bonus time" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDanger}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource OutlineButtonStyle}" Width="90" Margin="0,0,12,0" />
                <Button Content="Apply Override" Click="OnApplyClick" Style="{StaticResource PrimaryButtonStyle}" Width="130" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
