<Window x:Class="GameGuard.UI.Views.Dialogs.GameProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Profile Configuration"
        SizeToContent="Height"
        Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}">

    <Border Padding="24" Background="{StaticResource BrushSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TitleText" Text="Configure Game Profile" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Set game details and process names for zero-injection monitoring." Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Game Name -->
                <TextBlock Text="Game Title" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <TextBox x:Name="NameInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,14" />

                <!-- Executable Path with Browse -->
                <TextBlock Text="Executable Path (Optional)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExePathInput" Style="{StaticResource DarkTextBoxStyle}" Grid.Column="0" Margin="0,0,8,0" />
                    <Button Content="Browse..." Click="OnBrowseClick" Style="{StaticResource OutlineButtonStyle}" Grid.Column="1" Width="80" />
                </Grid>

                <!-- Process Names -->
                <TextBlock Text="Process Names (comma separated, e.g. cs2.exe, cs2)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6" />
                <TextBox x:Name="ProcessNamesInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,14" />

                <!-- Is Monitored Checkbox -->
                <CheckBox x:Name="MonitoredCheck" Content="Enable Active Runtime Monitoring" Style="{StaticResource DarkCheckBoxStyle}" IsChecked="True" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDanger}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource OutlineButtonStyle}" Width="90" Margin="0,0,12,0" />
                <Button Content="Save Profile" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" Width="120" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
