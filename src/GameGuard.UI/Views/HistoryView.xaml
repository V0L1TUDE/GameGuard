<UserControl x:Class="GameGuard.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:GameGuard.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:HistoryViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Session History &amp; Audit Log" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Logged gameplay sessions, termination reasons, and intercepted relaunch blocks." 
                               Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh Logs" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButtonStyle}" />
            </Grid>

            <!-- Recent Gameplay Sessions -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Recent Gameplay Sessions" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ElevatedCardBorderStyle}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" />
                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12">
                                                <Run Text="PID: " />
                                                <Run Text="{Binding ProcessId}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="16,0">
                                            <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="13">
                                                <Run Text="Started: " />
                                                <Run Text="{Binding StartTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC'}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Notes, TargetNullValue='Normal session'}" Style="{StaticResource SubtextStyle}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right">
                                                <Run Text="{Binding DurationSeconds}" />
                                                <Run Text="s" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TerminationReason}" Style="{StaticResource SubtextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Relaunch Blocks Log -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Suppressed Relaunch Attempts" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding BlockedRelaunches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ElevatedCardBorderStyle}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" />
                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12">
                                                <Run Text="PID: " />
                                                <Run Text="{Binding ProcessId}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="16,0">
                                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="Blocked at: " />
                                                <Run Text="{Binding BlockedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC'}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="{StaticResource BrushDanger}" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="BLOCKED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
