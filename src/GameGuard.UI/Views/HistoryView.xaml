<UserControl x:Class="GameGuard.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:GameGuard.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:HistoryViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <!-- Header Section -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Session History &amp; Analytics" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Detailed playtime trends, daily gaming allowances, and intercepted relaunch blocks." 
                               Style="{StaticResource SubtextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh Logs" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButtonStyle}" />
            </Grid>

            <!-- KPI Metric Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Today's Time -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PLAYTIME TODAY" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Text="{Binding TotalTodayFormatted}" Foreground="{StaticResource BrushAccent}" FontWeight="Black" FontSize="26" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 2: 7-Day Time -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PAST 7 DAYS" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Text="{Binding Total7DaysFormatted}" Foreground="{StaticResource BrushAccentCyan}" FontWeight="Black" FontSize="26" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Total Sessions -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOTAL SESSIONS" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Text="{Binding TotalSessionsCount}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Black" FontSize="26" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Blocked Relaunches -->
                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="BLOCKED RELAUNCHES" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock Text="{Binding TotalBlockedCount}" Foreground="{StaticResource BrushDanger}" FontWeight="Black" FontSize="26" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Game Usage Breakdown (Past 30 Days) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="30-Day Game Playtime Distribution" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Past 30 Days Active History" Style="{StaticResource SubtextStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding GameBreakdowns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Background="{StaticResource BrushSurfaceElevated}" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title and Summary stats -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="(" />
                                                    <Run Text="{Binding SessionCount}" />
                                                    <Run Text=" sessions)" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalPlaytimeFormatted}" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PercentageFormatted}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Visual Progress / Share Bar -->
                                        <Border Grid.Row="1" Height="8" Background="{StaticResource BrushBorder}" CornerRadius="4">
                                            <Grid HorizontalAlignment="Left" Width="{Binding BarWidthPercentage, RelativeSource={RelativeSource AncestorType=Border}, ConverterParameter=Scale}">
                                                <!-- Custom bar width representation via Border -->
                                                <Border Background="{StaticResource BrushAccent}" CornerRadius="4" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Filter Controls Bar -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Game:" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterGames}" SelectedItem="{Binding SelectedGameFilter}" Style="{StaticResource DarkComboBoxStyle}" />

                    <TextBlock Grid.Column="3" Text="Range:" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding FilterDateRanges}" SelectedItem="{Binding SelectedDateRange}" Style="{StaticResource DarkComboBoxStyle}" />
                </Grid>
            </Border>

            <!-- Filtered Gameplay Sessions -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Logged Gaming Sessions" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ElevatedCardBorderStyle}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Process & Game Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="{Binding ProcessName}" />
                                                <Run Text=" (PID " />
                                                <Run Text="{Binding ProcessId}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Timestamps & Audit Notes -->
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="13">
                                                <Run Text="Started: " />
                                                <Run Text="{Binding StartTimeLocalFormatted}" />
                                                <Run Text="  →  Ended: " />
                                                <Run Text="{Binding EndTimeLocalFormatted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Notes, TargetNullValue='Standard play session'}" Style="{StaticResource SubtextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Duration & Termination Badge -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DurationFormatted}" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                                            <Border Background="{Binding TerminationBadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TerminationBadgeText}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Suppressed Relaunch Attempts Log -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Suppressed Relaunch Attempts" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding BlockedRelaunches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ElevatedCardBorderStyle}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" />
                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12">
                                                <Run Text="PID: " />
                                                <Run Text="{Binding ProcessId}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="16,0">
                                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" />
                                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="Blocked at: " />
                                                <Run Text="{Binding BlockedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC'}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="{StaticResource BrushDanger}" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="BLOCKED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>