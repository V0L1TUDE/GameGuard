<Window x:Class="GameGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:GameGuard.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="GameGuard — Desktop Gaming Time Limiter" 
        Height="720" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation Rail -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="8,0,8,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cyber Gamer Shield Icon -->
                        <Border Grid.Column="0" Width="36" Height="36" Background="{StaticResource BrushSurfaceElevated}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="GAMEGUARD" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Black" FontSize="16" />
                            <TextBlock Text="OFFLINE TIME DEFENSE" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding NavigateDashboardCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateGamesCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Monitored Games" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateLimitsCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Daily Limits" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateHistoryCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Session History" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateSettingsCommand}" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Settings &amp; Admin" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status & Anti-Cheat Badge Footer -->
                <Border Grid.Row="2" Background="{StaticResource BrushSurfaceElevated}" BorderBrush="{StaticResource BrushBorderHighlight}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}" Margin="0,0,8,0" />
                            <TextBlock Text="ACTIVE PROTECTION" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="10" />
                        </StackPanel>
                        <TextBlock Text="Safe for Vanguard &amp; VAC" Style="{StaticResource SubtextStyle}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="Zero Anti-Cheat Injection" Style="{StaticResource SubtextStyle}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Status Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="32,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccentCyan}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontWeight="Medium" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource BrushSurfaceElevated}" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 OFFLINE MODE" Foreground="{StaticResource BrushTextSecondary}" FontWeight="Bold" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Page Content Host -->
            <ContentPresenter Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
